# Copy to .env and fill in real values. Never commit .env.
NAVBOT_ENV=production
JWT_SECRET=replace-with-64-random-hex-characters
ROBOT_KEY=replace-with-32-random-hex-characters
DELIVERY_POINT=DP1
REQUIRE_ROBOT=1

